<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox onKeyPressed="#onKeyPressed" prefHeight="720.0" prefWidth="1050.0" spacing="10.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.distribuidoragueguense.Controllers.DistribuidoraController">
    <children>

        <!-- ENCABEZADO CON LOGO Y TÍTULO -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #7e7d6f; -fx-padding: 12 20 12 20;">
            <children>
                <ImageView fx:id="imgInstitucional" fitHeight="55.0" fitWidth="55.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Distribuidora el Gueguense" textFill="WHITE">
                            <font>
                                <Font name="Bodoni MT Poster Compressed" size="44.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- CONTENEDOR PRINCIPAL: FORMULARIO (IZQUIERDA) Y TABLA (DERECHA) -->
        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- PANEL DEL FORMULARIO CON SCROLL -->
                <ScrollPane fitToWidth="true" prefWidth="420.0" style="-fx-background-color: transparent;">
                    <content>
                        <VBox prefHeight="622.0" prefWidth="381.0" spacing="10.0" style="-fx-background-color: #C9C7C3; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;">
                            <children>
                                <Label text="Datos del Colaborador" textFill="#6b5f51" wrapText="true">
                                    <font>
                                        <Font name="Bodoni MT Condensed Bold" size="25.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="90.0" right="80.0" />
                                    </VBox.margin>
                                </Label>

                                <!-- NOMBRES Y APELLIDOS -->
                                <Label text="Nombres:" textFill="#7e7d6f">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtNombres" promptText="Ej. Jose" style="-fx-background-radius: 5;" />

                                <Label text="Apellidos:" textFill="#7e7d6f">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtApellidos" promptText="Ej. Duran" style="-fx-background-radius: 5;" />

                                <!-- USUARIO Y CONTRASEÑA -->
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Usuario (mín. 5 car.):" textFill="#7e7d6f">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <TextField fx:id="txtUsuario" promptText="&lt;Inserte Usuario&gt;" style="-fx-background-radius: 5;" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Contraseña (mín. 8 car.):" textFill="#7e7d6f">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <PasswordField fx:id="txtPassword" promptText="••••••••" style="-fx-background-radius: 5;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- FECHA DE CONTRATACIÓN Y CARGO -->
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Fecha de Contratación:" textFill="#7e7d6f">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <DatePicker fx:id="dpFechaContratacion" maxWidth="1.7976931348623157E308" promptText="dd/mm/aaaa" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Cargo:" textFill="#7e7d6f">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="cmbCargo" maxWidth="1.7976931348623157E308" promptText="Seleccione..." />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- ÁREA DE TRABAJO (LISTVIEW) -->
                                <Label text="Seleccione un Área de Trabajo:" textFill="#7e7d6f">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ListView fx:id="lvArea" prefHeight="95.0" style="-fx-background-radius: 5;" />

                                <!-- TIPO DE CONTRATO (RADIOBUTTONS) -->
                                <Label text="Tipo de Contrato:" textFill="#7e7d6f">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <HBox spacing="25.0">
                                    <children>
                                        <RadioButton fx:id="rbIndefinido" mnemonicParsing="false" text="Indefinido" />
                                        <RadioButton fx:id="rbTemporal" mnemonicParsing="false" text="Temporal" />
                                    </children>
                                </HBox>

                                <!-- BENEFICIOS (CHECKBOXES) -->
                                <Label text="Beneficios laborales:" textFill="#7e7d6f">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="15.0" vgap="8.0">
                                    <children>
                                        <CheckBox fx:id="chkSeguroMedico" mnemonicParsing="false" text="Seguro Médico" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <CheckBox fx:id="chkViaticos" mnemonicParsing="false" text="Viáticos" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <CheckBox fx:id="chkBonoAlimentacion" mnemonicParsing="false" text="Bono de Alimentación" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <CheckBox fx:id="chkCapacitaciones" mnemonicParsing="false" text="Capacitaciones" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                           <columnConstraints>
                              <ColumnConstraints />
                              <ColumnConstraints />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints />
                              <RowConstraints />
                           </rowConstraints>
                                </GridPane>

                                <!-- BOTONES DE ACCIÓN (CRUD) -->
                                <VBox spacing="8.0">
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                    <children>
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#btnGuardarOnAction" prefHeight="35.0" prefWidth="175.0" style="-fx-background-color: #6b5f51; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Button>
                                                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#btnActualizarOnAction" prefHeight="35.0" prefWidth="175.0" style="-fx-background-color: #8c8375; -fx-background-radius: 6; -fx-cursor: hand;" text="Actualizar" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#btnLimpiarOnAction" prefHeight="32.0" prefWidth="175.0" style="-fx-background-color: #e2e8f0; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Button>
                                                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#btnEliminarOnAction" prefHeight="32.0" prefWidth="175.0" style="-fx-background-color: #d9534f; -fx-background-radius: 6; -fx-cursor: hand;" text="Eliminar" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- PANEL DE LA TABLA (DERECHA) -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Empleados Registrados" textFill="#6b5f51">
                                    <font>
                                        <Font name="Bodoni MT Condensed" size="27.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" right="20.0" />
                                    </HBox.margin>
                                </Label>
                                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="lblTotalRegistros" text="Total registrados: 0" textFill="#475569">
                                            <font>
                                                <Font name="Bodoni MT Condensed Bold" size="16.0" />
                                            </font>
                                            <HBox.margin>
                                                <Insets right="20.0" />
                                            </HBox.margin>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <TableView fx:id="tblTrabajadores" onMouseClicked="#tblTrabajadoresOnMouseClicked" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNombreCompleto" prefWidth="160.0" text="Nombre Completo" />
                                <TableColumn fx:id="colCargo" prefWidth="120.0" text="Cargo" />
                                <TableColumn fx:id="colArea" prefWidth="130.0" text="Área de Trabajo" />
                                <TableColumn fx:id="colFechaContratacion" prefWidth="110.0" text="Fecha Cont." />
                                <TableColumn fx:id="colTipoContrato" prefWidth="100.0" text="Tipo Contrato" />
                                <TableColumn fx:id="colBeneficios" prefWidth="160.0" text="Beneficios" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="5.0" />
            </padding>
        </HBox>
    </children>
</VBox>
