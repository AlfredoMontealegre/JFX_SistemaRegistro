<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="720.0" prefWidth="1050.0" spacing="10.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.centronic.controllers.MatriculaController">
    <children>

        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #7e7d6f; -fx-padding: 12 20 12 20;">
            <children>
                <ImageView fx:id="imgLogo" fitHeight="55.0" fitWidth="55.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Distribuidora el Gueguense" textFill="WHITE">
                            <font>
                                <Font name="Bodoni MT Poster Compressed" size="44.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- CONTENEDOR PRINCIPAL: FORMULARIO (IZQUIERDA) Y TABLA (DERECHA) -->
        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- PANEL DEL FORMULARIO CON SCROLL -->
                <ScrollPane fitToWidth="true" prefWidth="420.0" style="-fx-background-color: transparent;">
                    <content>
                        <VBox prefHeight="622.0" prefWidth="381.0" spacing="10.0" style="-fx-background-color: C9C7C3; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;">
                            <children>
                                <Label text="Datos del Usuario" textFill="#6b5f51">
                                    <font>
                                        <Font name="Bodoni MT Condensed Bold" size="25.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets left="90.0" right="80.0" />
                                    </VBox.margin>
                                </Label>

                                <!-- NOMBRES Y APELLIDOS -->
                                <Label text="Nombres:" textFill="#7e7d6f">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtNombres" promptText="Ej. Jose" style="-fx-background-radius: 5;" />

                                <Label text="Apellidos:" textFill="#7e7d6f">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <TextField fx:id="txtApellidos" promptText="Ej. Duran" style="-fx-background-radius: 5;" />

                                <!-- USUARIO Y CONTRASEÑA -->
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Usuario (mín. 5 car.):" textFill="#7e7d6f">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>
                                                <TextField fx:id="txtUsuario" promptText="&lt;Inserte Usuario&gt;" style="-fx-background-radius: 5;" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Contraseña (mín. 8 car.):" textFill="#7e7d6f">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>
                                                <PasswordField fx:id="txtPassword" promptText="••••••••" style="-fx-background-radius: 5;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- FECHA DE NACIMIENTO Y DEPARTAMENTO -->
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Fecha de Contratacion:" textFill="#7e7d6f">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>
                                                <DatePicker fx:id="dpFechaNacimiento" maxWidth="1.7976931348623157E308" promptText="dd/mm/aaaa" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Cargo:" textFill="#7e7d6f">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>
                                                <ComboBox fx:id="cmbDepartamento" maxWidth="1.7976931348623157E308" promptText="Seleccione..." />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- CURSO (LISTVIEW) -->
                                <Label text="Seleccione un Area de Trabajo:" textFill="#7e7d6f">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <ListView fx:id="lvCursos" prefHeight="95.0" style="-fx-background-radius: 5;" />

                                <!-- MODALIDAD (RADIOBUTTONS) -->
                                <Label text="Modalidad:" textFill="#7e7d6f">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <HBox spacing="25.0">
                                    <children>
                                        <RadioButton fx:id="rbPresencial" mnemonicParsing="false" text="Jornada" />
                                        <RadioButton fx:id="rbVirtual" mnemonicParsing="false" text="Fijo" />
                                    </children>
                                </HBox>

                                <!-- HORARIOS (CHECKBOXES) -->
                                <Label text="Horario preferido:" textFill="#7e7d6f">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <HBox spacing="15.0">
                                    <children>
                                        <CheckBox fx:id="chkMatutino" mnemonicParsing="false" text="Diurna" />
                                        <CheckBox fx:id="chkVespertino" mnemonicParsing="false" text="Nocturna" />
                                        <CheckBox fx:id="chkSabatino" mnemonicParsing="false" text="Mixta" />
                                    </children>
                                </HBox>

                                <!-- BOTONES DE ACCIÓN -->
                                <HBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#registrarOnClick" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #6b5f51; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarOnClick" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #e2e8f0; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Button>
                                    </children>
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- PANEL DE LA TABLA (DERECHA) -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Empleados Registrados" textFill="#6b5f51">
                                    <font>
                                        <Font name="Bodoni MT Condensed" size="27.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="100.0" right="100.0" />
                                    </HBox.margin>
                                </Label>
                                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="lblTotalRegistros" text="Total registrados: 0" textFill="#475569">
                                            <font>
                                                <Font name="Bodoni MT Condensed Bold" size="16.0" />
                                            </font>
                                            <HBox.margin>
                                                <Insets left="30.0" right="60.0" />
                                            </HBox.margin>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <TableView fx:id="tblEstudiantes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNombreCompleto" prefWidth="160.0" text="Nombre Completo" />
                                <TableColumn fx:id="colDepartamento" prefWidth="100.0" text="Cargo" />
                                <TableColumn fx:id="colCurso" prefWidth="110.0" text="Trabajo" />
                                <TableColumn fx:id="colModalidad" prefWidth="90.0" text="Modalidad" />
                                <TableColumn fx:id="colHorario" prefWidth="90.0" text="Horario" />
                                <TableColumn fx:id="colFechaNac" prefWidth="90.0" text="Fecha Cont." />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="5.0" />
            </padding>
        </HBox>
    </children>
</VBox>
